{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "geoleaf/themes",
    "title": "GeoLeaf Themes",
    "description": "themes.json — layer visibility presets (themes) for a GeoLeaf profile. Strict schema (PRF-SCHEMA, Profile Contract v1). Note: the canonical default-theme key is the root-level `defaultTheme`; the legacy/typo `config.defautTheme` is tolerated.",
    "type": "object",
    "additionalProperties": false,
    "patternProperties": { "^_comment": {} },
    "properties": {
        "$schema": { "type": "string" },
        "defaultTheme": {
            "type": "string",
            "description": "ID of the theme active on startup (canonical, root-level). Absent, or naming no theme of the list: the first theme with an id, which also decides the layers loaded at startup."
        },
        "config": {
            "type": "object",
            "description": "Global theme configuration.",
            "additionalProperties": false,
            "patternProperties": { "^_comment": {} },
            "properties": {
                "defautTheme": {
                    "type": "string",
                    "description": "LEGACY/TYPO of defaultTheme (present in one profile), read when the root-level defaultTheme names no theme of the list. Use the root-level defaultTheme."
                },
                "primaryThemes": {
                    "type": "object",
                    "additionalProperties": false,
                    "patternProperties": { "^_comment": {} },
                    "properties": {
                        "enabled": { "type": "boolean", "description": "Show primary themes UI." },
                        "position": {
                            "type": "string",
                            "enum": ["top-map", "top-layermanager"],
                            "description": "Position of primary themes control."
                        }
                    }
                },
                "secondaryThemes": {
                    "type": "object",
                    "additionalProperties": false,
                    "patternProperties": { "^_comment": {} },
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Show secondary themes UI."
                        },
                        "placeholder": {
                            "type": "string",
                            "description": "Placeholder text for secondary theme selector."
                        },
                        "showNavigationButtons": {
                            "type": "boolean",
                            "description": "Show prev/next navigation buttons."
                        },
                        "position": {
                            "type": "string",
                            "enum": ["top-map", "top-layermanager"],
                            "description": "Position of secondary themes control."
                        }
                    }
                }
            }
        },
        "themes": {
            "type": "array",
            "description": "Theme definitions.",
            "items": {
                "$ref": "#/definitions/themeEntry"
            }
        }
    },
    "definitions": {
        "themeEntry": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "patternProperties": { "^_comment": {} },
            "properties": {
                "id": { "type": "string", "description": "Unique theme identifier." },
                "label": { "type": "string", "description": "Display label (defaults to id)." },
                "type": {
                    "type": "string",
                    "enum": ["primary", "secondary"],
                    "default": "secondary",
                    "description": "Theme type. Affects UI placement."
                },
                "description": { "type": "string", "description": "Theme description." },
                "icon": { "type": "string", "description": "Emoji or icon name." },
                "layers": {
                    "type": "array",
                    "description": "Layer visibility settings for this theme.",
                    "items": {
                        "type": "object",
                        "required": ["id"],
                        "additionalProperties": false,
                        "patternProperties": { "^_comment": {} },
                        "properties": {
                            "id": {
                                "type": "string",
                                "description": "Layer ID (must match layers.json)."
                            },
                            "visible": {
                                "type": "boolean",
                                "description": "Layer visibility in this theme."
                            },
                            "style": {
                                "type": "string",
                                "description": "Style ID to apply in this theme."
                            }
                        }
                    }
                },
                "view": {
                    "type": "object",
                    "description": "Where this theme frames the map: `bounds`, or `center` with `zoom`. Activating the theme moves the camera there, before its layers load. When it is the theme the profile starts on, the map starts on it, unless the page address carries a view. Absent: activating the theme leaves the camera where it is, and a profile whose start theme declares none starts on its `map` extent. The navigation limit (`map.positionFixed`) and the padding (`map.padding`) stay the profile's. A legacy root-level `themes.json`, read after the map exists, frames on activation only.",
                    "additionalProperties": false,
                    "patternProperties": { "^_comment": {} },
                    "anyOf": [
                        { "properties": { "bounds": true }, "required": ["bounds"] },
                        {
                            "properties": { "center": true, "zoom": true },
                            "required": ["center", "zoom"]
                        }
                    ],
                    "properties": {
                        "bounds": {
                            "type": "array",
                            "description": "Extent to fit, [[south, west], [north, east]] - the writing of `map.bounds`. Wins over `center` when both are given and it is usable; an unreadable extent beside a valid `center` and `zoom` yields to them.",
                            "items": {
                                "type": "array",
                                "items": { "type": "number" },
                                "minItems": 2,
                                "maxItems": 2
                            },
                            "minItems": 2,
                            "maxItems": 2
                        },
                        "center": {
                            "type": "array",
                            "description": "Point to stand on, [lat, lng] - the writing of `map.center`. Read with `zoom`.",
                            "items": { "type": "number" },
                            "minItems": 2,
                            "maxItems": 2
                        },
                        "zoom": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Zoom level at `center`."
                        }
                    }
                }
            }
        }
    }
}
