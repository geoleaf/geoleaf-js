{
    "_comment": "B6 fixture (config-contract Phase C, sprint S14). TEST-ONLY. Reference POINT style for reference-points — schema-valid, exercises the flat style leaves (radius/colors/stroke), the top-level `label` STRING branch (selector label), scaleConfig+labelScale (both scale denominators), expressionPaint (ANO-070 wired), legend.items (ANO-074 orphan), and styleRules covering ==/>=/all/in. The `label` OBJECT branch + line/fill/casing/hatch/fillExtrusion + the remaining operators live in alt.json. Per-value variations via deepMerge in s14-*. Mirrors style.schema.json leaf-by-leaf so fixture and assertions cannot drift.",
    "id": "defaut",
    "label": "Défaut",
    "description": "Style de référence (point) — S14 B6",
    "scaleConfig": {
        "minScale": 50000,
        "maxScale": 1000
    },
    "labelScale": {
        "minScale": 50000,
        "maxScale": 1000
    },
    "style": {
        "shape": "circle",
        "radius": 8,
        "fillColor": "#9b2226",
        "fillOpacity": 0.9,
        "color": "#ffffff",
        "weight": 2,
        "opacity": 1,
        "expressionPaint": {
            "circle-blur": 0.3
        }
    },
    "styleRules": [
        {
            "when": {
                "field": "properties.category",
                "operator": "==",
                "value": "A"
            },
            "style": {
                "fillColor": "#0a9396",
                "radius": 10
            },
            "legend": {
                "label": "Catégorie A",
                "order": 1
            }
        },
        {
            "when": {
                "field": "properties.score",
                "operator": ">=",
                "value": 5
            },
            "style": {
                "fillColor": "#ee9b00"
            },
            "legend": {
                "label": "Score ≥ 5",
                "order": 2
            }
        },
        {
            "when": {
                "all": [
                    {
                        "field": "properties.score",
                        "operator": ">=",
                        "value": 10
                    },
                    {
                        "field": "properties.score",
                        "operator": "<=",
                        "value": 20
                    }
                ]
            },
            "style": {
                "fillColor": "#ca6702"
            },
            "legend": {
                "label": "Score 10–20",
                "order": 3
            }
        },
        {
            "when": {
                "field": "properties.category",
                "operator": "in",
                "value": ["X", "Y"]
            },
            "style": {
                "fillColor": "#bb3e03"
            },
            "legend": {
                "label": "X ou Y",
                "order": 4
            }
        }
    ],
    "legend": {
        "label": "Points de référence"
    }
}
