{
    "_comment": "B6 fixture (config-contract Phase C, sprint S14). TEST-ONLY. Reference SURFACE/LINE style for reference-points — schema-valid, exercises the top-level `label` OBJECT branch (font/buffer/background/offset — ANO-064/065/066/067 non-mappés MapLibre), the line/fill leaves, hatch, casing (4 schema'd keys only — ANO-068 holds dashArray/lineCap/lineJoin OUT), fillExtrusion 3D, the `paint` passthrough (ANO-059 now merged), and styleRules covering !=/contains/startsWith/between/notIn. Mirrors style.schema.json leaf-by-leaf.",
    "id": "alt",
    "label": {
        "enabled": true,
        "visibleByDefault": false,
        "field": "properties.name",
        "font": {
            "family": "Open Sans",
            "sizePt": 11,
            "weight": 60,
            "bold": true,
            "italic": false
        },
        "color": "#1d3557",
        "opacity": 1,
        "buffer": {
            "enabled": true,
            "noFill": false,
            "color": "#ffffff",
            "opacity": 1,
            "sizePx": 2
        }
    },
    "description": "Style alternatif (surface/ligne) — S14 B6",
    "labelScale": {
        "minScale": null,
        "maxScale": null
    },
    "style": {
        "fillColor": "#386641",
        "fillOpacity": 0.5,
        "color": "#283618",
        "weight": 1.5,
        "opacity": 1,
        "dashArray": "4 2",
        "lineCap": "round",
        "lineJoin": "miter",
        "hatch": {
            "enabled": true,
            "type": "diagonal",
            "spacingPx": 6,
            "angleDeg": 45,
            "renderMode": "overlay",
            "stroke": {
                "color": "#283618",
                "opacity": 0.6,
                "widthPx": 1
            }
        },
        "casing": {
            "enabled": true,
            "color": "#000000",
            "opacity": 0.8,
            "widthPx": 1
        },
        "fillExtrusionColor": "#6a994e",
        "fillExtrusionOpacity": 0.9,
        "fillExtrusionHeight": "properties.height",
        "fillExtrusionBase": 0,
        "paint": {
            "fill-antialias": true
        }
    },
    "styleRules": [
        {
            "when": {
                "field": "properties.zone",
                "operator": "!=",
                "value": "core"
            },
            "style": {
                "fillColor": "#a7c957"
            },
            "legend": {
                "label": "Hors cœur",
                "order": 1
            }
        },
        {
            "when": {
                "field": "properties.label",
                "operator": "contains",
                "value": "park"
            },
            "style": {
                "fillColor": "#6a994e"
            },
            "legend": {
                "label": "Parc",
                "order": 2
            }
        },
        {
            "when": {
                "field": "properties.code",
                "operator": "startsWith",
                "value": "FR"
            },
            "style": {
                "fillColor": "#386641"
            },
            "legend": {
                "label": "France",
                "order": 3
            }
        },
        {
            "when": {
                "field": "properties.rank",
                "operator": "between",
                "value": [1, 3]
            },
            "style": {
                "fillColor": "#bc4749"
            },
            "legend": {
                "label": "Rang 1–3",
                "order": 4
            }
        },
        {
            "when": {
                "field": "properties.kind",
                "operator": "notIn",
                "value": ["a", "b"]
            },
            "style": {
                "fillColor": "#f2e8cf"
            },
            "legend": {
                "label": "Autre",
                "order": 5
            }
        }
    ],
    "legend": {
        "label": "Zones"
    }
}
