{
    "id": "hebergements",
    "label": "Hébergements",
    "zIndex": 96,
    "geometry": "point",
    "geometryType": "point",
    "interactiveShape": true,
    "showIconsOnMap": true,
    "data": {
        "directory": "data",
        "file": "hebergements.geojson"
    },
    "styles": {
        "directory": "styles",
        "default": "defaut.json",
        "available": [
            {
                "id": "defaut",
                "label": "défaut",
                "file": "defaut.json"
            }
        ]
    },
    "table": {
        "enabled": true,
        "columns": [
            {
                "field": "properties.name",
                "label": "Nom",
                "sortable": true,
                "width": "40%"
            },
            {
                "field": "properties.fclass",
                "label": "Type",
                "sortable": true,
                "width": "20%"
            },
            {
                "field": "properties.categoryId",
                "label": "Catégorie",
                "sortable": true,
                "width": "20%"
            },
            {
                "field": "properties.subcategoryId",
                "label": "Sous-catégorie",
                "sortable": true,
                "width": "20%"
            }
        ],
        "searchFields": ["properties.name"],
        "defaultSort": {
            "field": "properties.name",
            "order": "asc"
        }
    },
    "clustering": {
        "enabled": true,
        "maxClusterRadius": 80,
        "disableClusteringAtZoom": 12
    },
    "attributes": {
        "titleField": "properties.name",
        "fields": [
            {
                "field": "properties.name",
                "label": "Nom",
                "primitive": "string",
                "widget": "text",
                "display": {
                    "surfaces": ["tooltip", "popup", "sidepanel"],
                    "presentation": {
                        "emphasis": "title"
                    }
                }
            },
            {
                "field": "properties.fclass",
                "label": "Type",
                "primitive": "string",
                "widget": "text",
                "display": {
                    "surfaces": ["popup", "sidepanel"]
                }
            },
            {
                "field": "properties.categoryId",
                "label": "Catégorie",
                "primitive": "string",
                "widget": "text",
                "display": {
                    "surfaces": ["popup", "sidepanel"]
                }
            },
            {
                "field": "properties.subcategoryId",
                "label": "Sous-catégorie",
                "primitive": "string",
                "widget": "text",
                "display": {
                    "surfaces": ["popup", "sidepanel"]
                }
            }
        ]
    }
}
