    "feature-info": {
      "_comment": "S2 capacités-extraction — modules.feature-info (plugin @geoleaf-plugins/feature-info). Attribute-rendering capacity: tooltip (hover), popup (click), side-panel (selection) for GeoJSON/VT layers. Per-layer bindings live in layers/<id>/{id}_config.json under capabilities.feature-info. POI rendering stack delegated to this plugin since S2b (see CDC_plugin-feature-info.md).",
      "enabled": true
    },
    "filter": {
      "_comment": "S5 F4.3 — modules.filter (capacité in-core). Migration de searchConfig + ui.showFilterPanel. searchConfig = recherche + categories (ni proximité ni tags). Catégories portées à la seule couche 'candelabres' (elle porte categoryId/subCategoryId ; 'armoires' ne les porte pas — Option A).",
      "enabled": true,
      "title": "Filtrer",
      "fields": [
        {
          "id": "searchText",
          "kind": "text",
          "label": "Recherche textuelle",
          "placeholder": "Candélabre, secteur…",
          "searchFields": [
            "properties.id",
            "properties.secteur",
            "properties.adresse"
          ]
        },
        {
          "id": "categories",
          "kind": "taxonomy",
          "taxonomyRef": "poi-cat",
          "label": "Catégories",
          "field": "categoryId",
          "subField": "subCategoryId",
          "layers": [
            "candelabres"
          ]
        }
      ],
      "actions": {
        "applyLabel": "Appliquer",
        "resetLabel": "Réinitialiser"
      }
    }
