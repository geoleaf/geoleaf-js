    "legend": {
      "_comment": "S10/F2 — modules.legend (capacité in-core capabilities/legend). Migré depuis ui.showLegend. Gate seul (pas de legendConfig dans ce profil) → défauts appliqués (title:Legend, bottomleft, déplié).",
      "enabled": true
    },
    "taxonomy": {
      "_comment": "Taxonomy v3 — the capability owns the POINT SYMBOL: icon, iconColor and the marker disc (fill/stroke/strokeWidth). Point SIZE stays with the layer style (candelabres keeps radius 7). Amber palette, preserving the layer's existing yellow identity (fillColor #facc15). Glyphs are DARK here: a white stroke on light amber would be unreadable. NB the filter of this profile reads `subField: subCategoryId` (camelCase) while the taxonomy declares `subcategoryId` — pre-existing, out of scope.",
      "enabled": true,
      "icons": {
        "spriteUrl": "profiles/reunion-eclairage/icons/sprite_reunion.svg",
        "symbolPrefix": "reunion-poi-cat-"
      },
      "render": {
        "popup": {
          "showIconCategory": true,
          "showIconSubcategory": true,
          "colorBadges": true
        },
        "sidepanel": {
          "showIconCategory": true,
          "showIconSubcategory": true,
          "colorBadges": true
        }
      },
      "layers": {
        "candelabres": {
          "use": "poi-cat"
        },
        "armoires": {
          "use": "poi-cat"
        }
      },
