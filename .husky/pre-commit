# Package files[] gate (S1 — roadmap_architecture-application) — every entry of a
# package's files[] must exist on disk. npm drops a dangling entry silently, so a
# package can declare it ships a LICENSE and publish without one for months: that
# is exactly what happened (10 packages, plus addpoi listing "LICENCE" in French,
# an entry that could never match). Build outputs are exempt — an entry git ignores
# is an artifact whose absence is normal before a build, which is why the check
# keeps the trailing slash when asking git. Same worktree-aware WSL trampoline.
if command -v wsl.exe >/dev/null 2>&1 && [ "${OS:-}" = "Windows_NT" ]; then
  ROOT_WSL="$(wsl_run wslpath "$(git rev-parse --show-toplevel)" | tr -d '\r')"
  wsl_run bash -lc "cd \"$ROOT_WSL\" && node scripts/check-package-files.cjs"
else
  node scripts/check-package-files.cjs
fi

# SHIP-SPEC (passage public S1) — un specifier NU du tarball doit se résoudre HORS de ce
# monorepo. La classe entière est masquée par les symlinks de workspace : `@geoleaf/host-runtime`
# est `private: true` et 404 sur npm POUR TOUJOURS, et il résolvait vert ici — donc vert dans
# PUB-TYPES, vert dans `typecheck:consumer` (qui compile depuis packages/core/examples/, soit
# DANS le monorepo), et `TS2307` chez le premier intégrateur. Six `.d.ts` publiables étaient
# dans cet état. SHIP-SPEC-02 est SANS baseline, à dessein : déclarer un workspace privé en
# `dependencies` satisferait SHIP-SPEC-01 en rendant le paquet non installable.
# ⚠️ Lit `dist/` — comme `verify-plugin-contract` plus haut, il suppose un build. Mesuré à
# 0,88 s (1 343 fichiers lus sur l'AST TypeScript, jamais au grep : un relevé au grep remonte
# 5 faux positifs dans des `@example` TSDoc, dont un qui accuserait le core de violer
# `no-plugin-in-core`). Même trampoline WSL worktree-aware ; exit 1 sur toute fuite.
if command -v wsl.exe >/dev/null 2>&1 && [ "${OS:-}" = "Windows_NT" ]; then
  ROOT_WSL="$(wsl_run wslpath "$(git rev-parse --show-toplevel)" | tr -d '\r')"
  wsl_run bash -lc "cd \"$ROOT_WSL\" && node scripts/check-shipped-specifiers.cjs"
else
  node scripts/check-shipped-specifiers.cjs
fi

# Dead-code filet B3 (roadmap nettoyage, Sprint 2). Ce script grepe les
# consommateurs d'un export core dans TOUT le monorepo (pas seulement core) pour
# éviter les faux positifs sur l'API consommée par les plugins — y compris les
