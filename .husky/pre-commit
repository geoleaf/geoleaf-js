# Config consumers gate (S7 — roadmap nettoyage) — the other direction of the config
# contract: coverage above proves every key HAS a row; this proves each row's
# "Consommateur (file:line)" citation still points at real code.
# NO MORE BASELINE since R.43 (25/07/2026): the 62 drifts inherited from the S3→S6
# refactors were repaired one by one, so the gate now blocks on ANY hard drift instead
# of only on a new one. Proven by mutation in both categories before the baseline was
# dropped. Soft drifts (key no longer on the cited line, ambiguous suffix) stay
# non-blocking by design — they are probable false positives.
# --no-report is REQUIRED: without it the run rewrites a report that was deliberately
# deleted from the repo (2bc7c1e0), on every commit. ~350ms.
# Same worktree-aware WSL trampoline; exits 1 on any hard drift.
if command -v wsl.exe >/dev/null 2>&1 && [ "${OS:-}" = "Windows_NT" ]; then
  ROOT_WSL="$(wsl_run wslpath "$(git rev-parse --show-toplevel)" | tr -d '\r')"
  wsl_run bash -lc "cd \"$ROOT_WSL\" && node scripts/check-config-consumers.cjs --fail --no-report"
else
  node scripts/check-config-consumers.cjs --fail --no-report
fi

