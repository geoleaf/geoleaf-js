# mock (the "Global L assignment" lock). CI already runs this step; mirrored
# locally so it is caught before the push. Same worktree-aware WSL
# trampoline; verify-no-leaflet.cjs exits 1 on any hit.
if command -v wsl.exe >/dev/null 2>&1 && [ "${OS:-}" = "Windows_NT" ]; then
