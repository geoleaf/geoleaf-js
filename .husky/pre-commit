# à leur consommateur. C'est son apport propre face à knip : 51 des 74 candidats
# de sa baseline sont invisibles à knip (mesure 25/07/2026). N.B. l'ancien motif
# « knip est aveugle sur packages/core/src » est PÉRIMÉ — cause trouvée et
# corrigée à l'API S2.4, cf. l'en-tête de scripts/check-orphan-exports.cjs.
# Mesuré à ~800ms — assez rapide pour le pre-commit (contrairement à
# `dead-code`/knip, non câblé ici pour cette raison). Même trampoline WSL
# worktree-aware ; exit 1 sur tout candidat.
if command -v wsl.exe >/dev/null 2>&1 && [ "${OS:-}" = "Windows_NT" ]; then
  ROOT_WSL="$(wsl_run wslpath "$(git rev-parse --show-toplevel)" | tr -d '\r')"
  wsl_run bash -lc "cd \"$ROOT_WSL\" && node scripts/check-orphan-exports.cjs"
