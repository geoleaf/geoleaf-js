{
    "name": "@geoleaf-plugins/navigation",
    "version": "1.0.0",
    "type": "module",
    "license": "MIT",
    "description": "GeoLeaf navigation plugin",
    "main": "dist/geoleaf-navigation.plugin.js",
    "module": "dist/geoleaf-navigation.plugin.js",
    "types": "dist/types/entry.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/entry.d.ts",
            "import": "./dist/geoleaf-navigation.plugin.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/",
        "src/",
        "LICENSE"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "build": "rollup -c",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@geoleaf-plugins/routing": "^1.0.0",
        "@turf/bearing": "^7.4.0",
        "@turf/helpers": "^7.1.0",
        "@turf/nearest-point-on-line": "^7.4.0"
    },
    "peerDependencies": {
        "@geoleaf/core": "^3.0.0",
        "maplibre-gl": "^6.0.0"
    },
    "devDependencies": {
        "@geoleaf/core": "^3.0.0",
        "@geoleaf/build-config": "*",
        "@geoleaf/host-runtime": "*",
        "@vitest/coverage-istanbul": "^4.1.11",
        "rimraf": "^6.1.3",
        "rollup": "^4.63.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.8"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "geoleaf": {
        "bundle": "geoleaf-navigation.plugin.js",
        "lazyChunks": false,
        "includeFlag": null
    }
}
