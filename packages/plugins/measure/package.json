{
    "name": "@geoleaf-plugins/measure",
    "version": "1.0.2",
    "type": "module",
    "license": "MIT",
    "description": "GeoLeaf Measure Plugin — Distance, surface, GPS & annotation tools with GeoJSON export",
    "homepage": "https://geoleaf.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/geoleaf/geoleaf-js.git",
        "directory": "packages/plugins/measure"
    },
    "bugs": {
        "url": "https://github.com/geoleaf/geoleaf-js/issues"
    },
    "author": "Mattieu Pottier",
    "engines": {
        "node": ">=22"
    },
    "main": "dist/geoleaf-measure.plugin.js",
    "module": "dist/geoleaf-measure.plugin.js",
    "types": "dist/types/entry.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/entry.d.ts",
            "import": "./dist/geoleaf-measure.plugin.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/",
        "src/",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "build": "rollup -c",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@geoleaf/core": "^3.0.0",
        "@turf/distance": "^7.1.0",
        "@turf/area": "^7.1.0",
        "@turf/circle": "^7.1.0",
        "@turf/centroid": "^7.1.0",
        "@turf/helpers": "^7.1.0"
    },
    "peerDependencies": {
        "maplibre-gl": "^6.0.0"
    },
    "devDependencies": {
        "@geoleaf/build-config": "*",
        "@geoleaf/host-runtime": "*",
        "@vitest/coverage-istanbul": "^4.1.10",
        "happy-dom": "^20.11.2",
        "rimraf": "^5.0.5",
        "rollup": "^4.62.4",
        "typescript": "^5.9.3",
        "vitest": "^4.1.8"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    }
}
