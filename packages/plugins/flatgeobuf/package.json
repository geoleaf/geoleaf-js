{
    "name": "@geoleaf-plugins/flatgeobuf",
    "version": "1.0.2",
    "type": "module",
    "license": "MIT",
    "description": "GeoLeaf FlatGeobuf Plugin — Load and spatially filter FlatGeobuf files as GeoJSON layers with HTTP Range bbox support",
    "homepage": "https://geoleaf.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/geoleaf/geoleaf-js.git",
        "directory": "packages/plugins/flatgeobuf"
    },
    "bugs": {
        "url": "https://github.com/geoleaf/geoleaf-js/issues"
    },
    "author": "Mattieu Pottier",
    "engines": {
        "node": ">=22"
    },
    "main": "dist/geoleaf-flatgeobuf.plugin.js",
    "module": "dist/geoleaf-flatgeobuf.plugin.js",
    "types": "dist/types/entry.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/entry.d.ts",
            "import": "./dist/geoleaf-flatgeobuf.plugin.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/",
        "src/",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "build": "rollup -c",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@geoleaf/core": "^3.0.0",
        "@types/geojson": "^7946.0.16",
        "flatgeobuf": "^4.4.0"
    },
    "devDependencies": {
        "@geoleaf/build-config": "*",
        "@geoleaf/host-runtime": "*",
        "@vitest/coverage-istanbul": "^4.1.8",
        "happy-dom": "^20.9.0",
        "rimraf": "^5.0.5",
        "rollup": "^4.12.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.8"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    }
}
