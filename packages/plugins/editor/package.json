{
    "name": "@geoleaf-plugins/editor",
    "version": "1.2.0",
    "type": "module",
    "license": "MIT",
    "description": "GeoLeaf Editor Plugin — Geometry creation & editing (Point/Line/Polyline/Polygon) with Terra Draw, responsive form catalog, and online/offline persistence",
    "homepage": "https://geoleaf.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/geoleaf/geoleaf-js.git",
        "directory": "packages/plugins/editor"
    },
    "bugs": {
        "url": "https://github.com/geoleaf/geoleaf-js/issues"
    },
    "author": "Mattieu Pottier",
    "engines": {
        "node": ">=22"
    },
    "main": "dist/geoleaf-editor.plugin.js",
    "module": "dist/geoleaf-editor.plugin.js",
    "types": "dist/types/entry.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/entry.d.ts",
            "import": "./dist/geoleaf-editor.plugin.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/",
        "src/",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "build": "rollup -c",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@geoleaf/field-renderer": "^1.0.0",
        "@geoleaf/core": "^3.0.0",
        "@types/geojson": "^7946.0.16",
        "terra-draw": "^1.32.2",
        "terra-draw-maplibre-gl-adapter": "^1.4.1"
    },
    "peerDependencies": {
        "maplibre-gl": "^6.0.0"
    },
    "devDependencies": {
        "@geoleaf/build-config": "*",
        "@geoleaf/host-runtime": "*",
        "@vitest/coverage-istanbul": "^4.1.10",
        "rimraf": "^6.1.3",
        "rollup": "^4.12.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.8"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    }
}
