{
    "name": "geoleaf-monorepo",
    "version": "3.0.0",
    "private": true,
    "type": "module",
    "packageManager": "npm@11.6.2",
    "engines": {
        "node": ">=22.13.0"
    },
    "description": "GeoLeaf — Monorepo v3. MapLibre GL JS engine. Packages: @geoleaf/core, @geoleaf-plugins/*.",
    "workspaces": [
        "apps/*",
        "packages/*",
        "packages/plugins/*",
        "packages/libs/*",
        "!packages/_*"
    ],
    "scripts": {
        "build": "node scripts/purge-dist.cjs --quiet && turbo run build",
        "build:core": "turbo run build --filter=@geoleaf/core",
        "build:plugins": "turbo run build --filter=@geoleaf-plugins/*",
        "build:all": "turbo run build:all --filter=@geoleaf/core",
        "test": "node scripts/run-tests.cjs",
        "test:coverage:all": "node scripts/run-tests.cjs --coverage",
        "test:core": "turbo run test --filter=@geoleaf/core",
        "test:coverage": "turbo run test:coverage --filter=@geoleaf/core",
        "test:vitest": "vitest run",
        "test:vitest:core": "vitest run --config packages/core/vitest.config.ts",
        "test:vitest:coverage": "vitest run --coverage",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix --max-warnings 0",
        "count:any": "node scripts/count-any.cjs",
        "clean": "turbo run clean",
        "cache:purge": "node scripts/purge-turbo-cache.cjs",
        "benchmark": "node scripts/benchmark.cjs",
        "audit:security": "node scripts/audit-innerhtml.cjs",
        "audit:ci": "node scripts/audit-ci.cjs",
        "gitleaks:local": "node scripts/gitleaks-local.cjs",
        "ci:local": "node scripts/ci-local.cjs",
        "ci:push": "node scripts/ci-push.cjs",
        "smoke-test": "node scripts/smoke-test.cjs",
        "dead-code": "node scripts/check-dead-code.cjs",
        "check-i18n-shape": "node scripts/check-i18n-dict-shape.cjs",
        "check-orphan-exports": "node scripts/check-orphan-exports.cjs",
        "check-orphan-exports:update-baseline": "node scripts/check-orphan-exports.cjs --update-baseline",
        "check:contracts-pure": "node scripts/check-contracts-pure.cjs",
        "check:facade-purity": "node scripts/check-facade-purity.cjs",
        "check:dynamic-key-writes": "node scripts/check-dynamic-key-writes.cjs",
        "check:dynamic-key-writes:update-baseline": "node scripts/check-dynamic-key-writes.cjs --update-baseline",
        "dup:check": "jscpd packages",
        "verify:purgecss": "node scripts/verify-purgecss.cjs",
        "verify:css-tokens": "node scripts/verify-css-tokens.cjs",
        "size": "node scripts/check-bundle-size.cjs",
        "size:plugins": "node scripts/check-bundle-size.cjs --plugins",
        "size:app": "node scripts/check-app-payload.cjs",
        "size:example": "node scripts/check-example-bundle.cjs",
        "size:consumer": "node scripts/check-consumer-bundle.cjs",
        "check:side-effects": "node scripts/check-side-effects.cjs",
        "check:subpath-resolve": "node scripts/check-subpath-resolve.cjs",
        "check:shipped-specifiers": "node scripts/check-shipped-specifiers.cjs",
        "check:shipped-specifiers:update-baseline": "node scripts/check-shipped-specifiers.cjs --update-baseline",
        "check:license-headers": "node scripts/check-license-headers.cjs",
        "check:license-headers:write": "node scripts/check-license-headers.cjs --write",
        "typecheck:consumer": "npm run typecheck:consumer -w @geoleaf/core",
        "golden-master": "node scripts/golden-master.cjs",
        "build:deploy": "node scripts/build-deploy.cjs",
        "build:deploy:full": "node scripts/build-deploy.cjs --plugins=full",
        "build:deploy:all": "node scripts/build-deploy.cjs --plugins=all",
        "build:deploy:local": "node scripts/build-deploy.cjs --plugins=local",
        "demo": "npm run build:deploy:all && docker compose -f docker-compose.dev.yml up -d",
        "demo:up": "docker compose -f docker-compose.dev.yml up -d",
        "demo:down": "docker compose -f docker-compose.dev.yml down",
        "build:connector": "turbo run build --filter=@geoleaf-plugins/connector",
        "gen:config-reference": "node scripts/gen-config-reference.cjs",
        "gen:config-reference:check": "node scripts/gen-config-reference.cjs --check",
        "publish:core": "npm publish -w @geoleaf/core --access public",
        "publish:storage": "npm publish -w @geoleaf-plugins/offline-ui --access public",
        "publish:connector": "npm publish -w @geoleaf-plugins/connector --access public",
        "publish:plugins": "node scripts/publish-plugins.cjs",
        "prepare": "husky",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "perf:gate": "playwright test e2e/06-performance-baseline.spec.js",
        "perf:capture": "E2E_HW_GL=1 PERF_BASELINE_WRITE=1 playwright test e2e/06-performance-baseline.spec.js",
        "build:deploy-coverage": "node scripts/build-deploy-coverage.cjs",
        "report:e2e": "nyc report --nycrc-path nyc.config.cjs",
        "check:links": "node scripts/check-dead-links.cjs",
        "check:docs-examples": "node scripts/validate-docs-examples.cjs",
        "check:docs-typecheck": "node scripts/typecheck-docs-examples.cjs",
        "check:module-headers": "node scripts/check-module-headers.cjs",
        "check:exact-optional-debt": "node scripts/check-exact-optional-debt.cjs",
        "check:exact-optional-debt:update-baseline": "node scripts/check-exact-optional-debt.cjs --update-baseline",
        "check:nonnull-debt": "node scripts/check-nonnull-assertion-debt.cjs",
        "check:nonnull-debt:update-baseline": "node scripts/check-nonnull-assertion-debt.cjs --update-baseline",
        "check:js-test-debt": "node scripts/check-js-test-debt.cjs",
        "check:js-test-debt:update-baseline": "node scripts/check-js-test-debt.cjs --update-baseline",
        "check:dist-integrity": "node scripts/check-dist-integrity.cjs",
        "check:esm-purity": "node scripts/verify-esm-purity.cjs",
        "purge:dist": "node scripts/purge-dist.cjs",
        "check:doc-config-examples": "node scripts/check-doc-config-examples.cjs",
        "check:doc-config-examples:update-baseline": "node scripts/check-doc-config-examples.cjs --update-baseline",
        "check:tsdoc": "node scripts/check-tsdoc-conformity.cjs",
        "check:tsdoc:update-baseline": "node scripts/check-tsdoc-conformity.cjs --update-baseline",
        "check:tsdoc-paths": "node scripts/audit-report-freshness.cjs --source tsdoc --gate --quiet",
        "check:tsdoc-paths:update-baseline": "node scripts/audit-report-freshness.cjs --source tsdoc --gate --update-baseline --quiet",
        "check:host-sync": "node scripts/verify-host-contract-sync.cjs",
        "check:event-map": "node scripts/check-event-map-coverage.cjs",
        "check:event-map:update-baseline": "node scripts/check-event-map-coverage.cjs --update-baseline",
        "check:namespace-typing": "node scripts/check-namespace-typing-coverage.cjs",
        "check:namespace-typing:update-baseline": "node scripts/check-namespace-typing-coverage.cjs --update-baseline",
        "check:consumer-contract": "node scripts/verify-consumer-contract.cjs",
        "check:consumer-contract:update-baseline": "node scripts/verify-consumer-contract.cjs --update-baseline",
        "docs:api": "npm run docs:api -w @geoleaf/core",
        "gen:attributes-report": "node scripts/gen-attributes-report.cjs",
        "gen:attributes-report:check": "node scripts/gen-attributes-report.cjs --check",
        "gen:profile-schema": "node scripts/gen-profile-schema-reference.cjs",
        "gen:profile-schema:check": "node scripts/gen-profile-schema-reference.cjs --check",
        "gen:profile-schema:audit": "node scripts/gen-profile-schema-reference.cjs --audit",
        "gen:api-surface": "node scripts/gen-api-surface.cjs",
        "gen:api-surface:check": "node scripts/gen-api-surface.cjs --check",
        "docs:tree": "node scripts/generate-docs-tree.cjs",
        "docs:tree:check": "node scripts/generate-docs-tree.cjs --check",
        "icons:generate": "node scripts/generate-pwa-icons.cjs",
        "docs:deploy": "node scripts/deploy-docs.cjs",
        "audit:cleanup": "node scripts/audit-cleanup.cjs",
        "validate:profiles": "node scripts/validate-profiles.cjs",
        "check:template-layer-configs": "node scripts/check-template-layer-configs.cjs",
        "verify:contract": "node scripts/verify-plugin-contract.cjs --fail",
        "verify:config-coverage": "node scripts/check-config-coverage.cjs",
        "check:config-consumers": "node scripts/check-config-consumers.cjs",
        "verify:config-consumers": "node scripts/check-config-consumers.cjs --fail --no-report",
        "check:config-consumers:update-baseline": "node scripts/check-config-consumers.cjs --no-report --update-baseline",
        "versions:check": "node scripts/check-versions.cjs",
        "create:plugin": "node scripts/create-plugin.cjs",
        "check:determinism": "node scripts/check-build-determinism.cjs",
        "check:determinism:deploy": "node scripts/check-build-determinism.cjs --deploy",
        "check:determinism:deploy:ci": "node scripts/check-build-determinism.cjs --deploy --reuse-built"
    },
    "lint-staged": {
        "packages/**/src/**/*.{js,ts}": [
            "eslint --fix --max-warnings 0 --no-warn-ignored",
            "prettier --write"
        ],
        "packages/**/__tests__/**/*.{js,ts}": [
            "prettier --write"
        ],
        "packages/**/src/**/*.css": [
            "prettier --write"
        ],
        "apps/**/*.js": [
            "eslint --fix",
            "prettier --write"
        ],
        "e2e/**/*.{js,cjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@csstools/css-parser-algorithms": "^4.0.0",
        "@csstools/css-tokenizer": "^4.0.0",
        "@emnapi/core": "^1.11.2",
        "@emnapi/runtime": "^1.11.2",
        "@emnapi/wasi-threads": "^1.2.2",
        "@eslint/js": "^10.0.1",
        "@geoleaf/build-config": "*",
        "@playwright/test": "^1.62.1",
        "@typescript-eslint/eslint-plugin": "^8.66.0",
        "@typescript-eslint/parser": "^8.61.0",
        "@vitest/coverage-istanbul": "^4.1.10",
        "cssnano": "^8.0.4",
        "depcheck": "^1.4.7",
        "eslint": "^10.8.1",
        "eslint-plugin-security": "^4.0.1",
        "globals": "^17.9.0",
        "http-server": "^14.1.1",
        "husky": "^9.0.11",
        "jscpd": "^4.0.9",
        "knip": "^6.32.0",
        "lint-staged": "^15.2.2",
        "madge": "^8.0.0",
        "maplibre-gl": "^6.0.0",
        "nyc": "^18.0.0",
        "postcss": "^8.5.6",
        "postcss-import": "^16.1.1",
        "prettier": "^3.9.6",
        "purgecss": "^8.0.0",
        "rollup-plugin-esbuild": "^6.2.1",
        "serve": "^14.2.4",
        "turbo": "^2.10.9",
        "vitest": "^4.1.8",
        "web-vitals": "^5.3.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/geoleaf/geoleaf-js.git"
    },
    "bugs": {
        "url": "https://github.com/geoleaf/geoleaf-js/issues"
    },
    "homepage": "https://geoleaf.dev",
    "author": "Mattieu Pottier",
    "license": "MIT",
    "overrides": {
        "@csstools/css-parser-algorithms": "^4.0.0",
        "@csstools/css-tokenizer": "^4.0.0",
        "@emnapi/core": "^1.11.2",
        "@emnapi/runtime": "^1.11.2",
        "@emnapi/wasi-threads": "^1.2.2",
        "tar": "^7.5.9",
        "qs": "^6.14.1",
        "form-data": "^4.0.0",
        "tough-cookie": "^4.1.3",
        "serialize-javascript": "^7.0.3",
        "minimatch": "^10.0.0",
        "dompurify": "^3.4.13",
        "markdown-it": "^14.2.0",
        "protocol-buffers-schema": "^3.6.1",
        "brace-expansion": "^5.0.9"
    }
}
